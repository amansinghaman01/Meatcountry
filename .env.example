# Set these as server-side variables in Vercel Project Settings → Environment Variables.
# Never use NEXT_PUBLIC_ for any secret.
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/freshcart?retryWrites=true&w=majority
MONGODB_DATABASE=freshcart
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>

# Set temporarily only for the one-time admin bootstrap, then DELETE it from Vercel.
ADMIN_BOOTSTRAP_SECRET=<temporary-random-secret-at-least-32-characters>

# Razorpay Test Mode keys first; use Live keys only after end-to-end testing.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-test-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-test-webhook-signing-secret>


# Optional browser push notifications. Generate VAPID keys with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:hello@your-domain.example
